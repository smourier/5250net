<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<PublishAot>true</PublishAot>
		<ApplicationIcon>5250net.ico</ApplicationIcon>
		<Nullable>enable</Nullable>
		<RootNamespace>Terminal5250</RootNamespace>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>5250 terminal emulator for .NET as a Console Application</Description>
		<Title>5250net</Title>
		<Copyright>Copyright (C) 2025-2026 Simon Mourier. All rights reserved.</Copyright>
		<RepositoryUrl>https://github.com/smourier/5250net</RepositoryUrl>
		<Version>1.1.0</Version>
		<AssemblyTitle>5250net - AOT</AssemblyTitle>
		<Product>5250net</Product>
		<Company>Simon Mourier</Company>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="5250net.ico" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Assets\5250net.png" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" Version="2.0.14" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="System" />
		<Using Include="System.Buffers.Binary" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.CommandLine" />
		<Using Include="System.CommandLine.Help" />
		<Using Include="System.CommandLine.Invocation" />
		<Using Include="System.CommandLine.Parsing" />
		<Using Include="System.ComponentModel" />
		<Using Include="System.Diagnostics" />
		<Using Include="System.Globalization" />
		<Using Include="System.IO" />
		<Using Include="System.IO.Pipes" />
		<Using Include="System.Linq" />
		<Using Include="System.Net" />
		<Using Include="System.Net.Security" />
		<Using Include="System.Net.Sockets" />
		<Using Include="System.Reflection" />
		<Using Include="System.Runtime.InteropServices" />
		<Using Include="System.Security.Authentication" />
		<Using Include="System.Security.Cryptography" />
		<Using Include="System.Security.Cryptography.X509Certificates" />
		<Using Include="System.Text" />
		<Using Include="System.Text.Encodings.Web" />
		<Using Include="System.Text.Json" />
		<Using Include="System.Text.Unicode" />
		<Using Include="System.Threading" />
		<Using Include="System.Threading.Tasks" />
		<Using Include="Terminal5250.Properties" />
		<InternalsVisibleTo Include="5250net.Tests" />
	</ItemGroup>
	
	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<Compile Update="Properties\Resources.Designer.cs">
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
